-- /installer
-- Bootstrap: lädt xreactor/installer/init.lua und führt ihn aus.

local INSTALL_ROOT = "/xreactor"
local GITHUB_API   = "https://api.github.com/repos/ItIsYe/ExtreamReactor-Controller-V3/branches/beta"
local GITHUB_RAW   = "https://raw.githubusercontent.com/ItIsYe/ExtreamReactor-Controller-V3/"

local function p(msg) pcall(print, tostring(msg)) end

local function download(url)
  local ok, r = pcall(http.get, url)
  if not ok or not r then return nil, "download failed" end
  local ok2, body = pcall(r.readAll); pcall(r.close)
  if not ok2 or type(body) ~= "string" then return nil, "read failed" end
  local s = body:sub(1, 200):lower()
  if s:find("<html", 1, true) or s:find("<!doctype", 1, true) then
    return nil, "unexpected HTML"
  end
  return body
end

local function write(path, content)
  local dir = fs.getDir(path)
  if dir and dir ~= "" and not fs.exists(dir) then pcall(fs.makeDir, dir) end
  local f = fs.open(path, "w"); if not f then return false end
  f.write(content); f.close(); return true
end

-- SHA auflösen (ohne timeout-Argument — CC:Tweaked kompatibel)
local sha = nil
if http and type(http.get) == "function" then
  local ok, r = pcall(http.get, GITHUB_API)
  if ok and r then
    local ok2, body = pcall(r.readAll); pcall(r.close)
    if ok2 and type(body) == "string" then
      sha = body:match('"sha"%s*:%s*"(%x+)"')
    end
  end
end

local base = sha
  and (GITHUB_RAW .. sha .. "/xreactor/")
  or  (GITHUB_RAW .. "beta/xreactor/")

p(sha and ("SHA-PIN: " .. sha:sub(1,10)) or "WARN: SHA nicht auflösbar — nutze Branch-URL")

local MODULES = {
  "installer/http.lua", "installer/manifest.lua", "installer/stage.lua",
  "installer/ui.lua", "installer/auto_update.lua", "installer/init.lua",
}

p("Lade Installer-Module...")
for _, rel in ipairs(MODULES) do
  local body, err = download(base .. rel)
  -- Fallback auf Branch-URL wenn SHA-URL fehlschlägt
  if not body and sha then
    p("  Fallback fuer " .. rel)
    body, err = download(GITHUB_RAW .. "beta/xreactor/" .. rel)
  end
  if not body then error("Download: " .. rel .. " -- " .. tostring(err), 0) end
  if not write(INSTALL_ROOT .. "/" .. rel, body) then
    error("Schreiben fehlgeschlagen: " .. rel, 0)
  end
  p("  OK " .. rel)
end

p("Starte Installer...")
dofile(INSTALL_ROOT .. "/installer/init.lua")
if _G.__xreactor_installer_completed then
  p("Fertig -- Neustart..."); os.sleep(1); os.reboot()
end
