-- Dateien im Fallback-Fall sowieso liefert.
p("Lade Manifest...")
local man_body, man_err
man_body, man_err = download(GITHUB_RAW.."beta/xreactor/manifest.lua")
if not man_body then error("Manifest Download fehlgeschlagen: "..tostring(man_err), 0) end

local manifest, merr = manifest_mod.load_remote(GITHUB_RAW.."beta/xreactor/manifest.lua", {
  download = download, is_html = http_mod.is_html
})
-- Fallback: Manifest direkt parsen
if not manifest then
  local fn, lerr = load(man_body, "=manifest", "t", {})
  if not fn then error("Manifest Parse: "..tostring(lerr), 0) end
  local ok3, result = pcall(fn)
  if not ok3 or type(result)~="table" then error("Manifest ungültig: "..tostring(result), 0) end
  manifest = result
end
p("Manifest: "..tostring(manifest.manifest_id or manifest.manifest_version))

-- ── Rolle bestimmen ──────────────────────────────────────────────────────────
local role = nil
local role_path = INSTALL_ROOT.."/config/role.lua"
if fs.exists(role_path) then
  local f = fs.open(role_path, "r"); if f then
    local src = f.readAll(); f.close()
    local loader = load(src, "=role", "t", {})
    if loader then
      local ok4, result = pcall(loader)
      if ok4 and type(result)=="table" and type(result.role)=="string" then
        local existing = result.role
        p("Vorhandene Rolle: "..existing)
        if _G.__xreactor_remote_update or ui_mod.confirm("Rolle '"..existing.."' behalten?") then
          role = { key=existing:lower(), label=existing:upper() }
        end
      end
    end
  end
end
if not role then
  -- Fix (2026-07-06): CRITICAL, identisch zum ersten Vorkommen weiter
  -- oben — dieser Codeblock ist der tatsaechliche Pfad, der bei JEDEM
  -- automatischen Auto-Update durchlaeuft (siehe Kommentar unten). Ohne
  -- diesen Schutz haette ein fehlendes/ungueltiges role.lua den gesamten
  -- unbeaufsichtigten Update-Prozess fuer immer haengen lassen.
  if _G.__xreactor_remote_update then
    error("Automatisches Update abgebrochen: config/role.lua fehlt oder ist ungueltig — keine Rolle bekannt und keine interaktive Auswahl im unbeaufsichtigten Modus moeglich.", 0)
  end
  role = ui_mod.select_role()
  if not role then error("Keine Rolle gewählt", 0) end
end
ui_mod.header("Installiere "..role.label)

-- ── Wichtige Dateien sichern ─────────────────────────────────────────────────
-- Fix (2026-06-30): role.lua fehlte hier in PRESERVE — das ist der
-- Auto-Update-Reinstall-Pfad, der bei jedem automatischen Update durchlaeuft.
-- Ohne role.lua in dieser Liste ging die Rollenzuordnung bei jedem
-- Auto-Update verloren, der Node bootete danach ohne konfigurierte Rolle.
local PRESERVE = { "config/node_id.txt", "config/capacity_cache.lua", "config/role.lua", "config/optional_features.lua", "config/ampel_thresholds.lua" }
local preserved = {}
for _, rel in ipairs(PRESERVE) do
  local src = INSTALL_ROOT.."/"..rel
  if fs.exists(src) then
    local f = fs.open(src, "r"); if f then preserved[rel]=f.readAll(); f.close() end
  end
end

-- Feature (2026-07-01): beim automatischen Auto-Update-Reinstall wird NICHT
-- erneut interaktiv nach optionalen Features gefragt (kein Nutzer anwesend,
-- der Prozess soll unbeaufsichtigt durchlaufen) — die zuvor gespeicherte
-- Auswahl wird einfach uebernommen. War optional_features.lua noch nie
-- geschrieben (z.B. alter Node vor diesem Feature), bleibt die Auswahl leer
-- und keine optionalen Dateien werden installiert — sicherer Default.
local selected_features = {}
do
  local raw = preserved["config/optional_features.lua"]
  if raw then
    local ok, loaded = pcall(function()
      local chunk = load(raw, "=optional_features", "t", {})
      if not chunk then return nil end
      return chunk()
    end)
    if ok and type(loaded) == "table" then selected_features = loaded end
  end
end

-- Fix (2026-07-06): CRITICAL. Dieser komplette Codeblock (SHA aufloesen /
-- Manifest laden / Rolle bestimmen / PRESERVE / Alte Installation loeschen
-- / Dateien installieren, ab Zeile ~928) ist der Code-Pfad, der TATSAECHLICH
-- laeuft, wenn der Nutzer den Installer manuell startet UND "Rolle
-- behalten? Ja" bestaetigt — NICHT init_src weiter oben (das erreicht man
-- nur, wenn man /xreactor/installer/init.lua separat aufruft, was in der
-- Praxis kaum vorkommt). Der urspruengliche Kommentar "beim automatischen
-- Auto-Update-Reinstall wird NICHT erneut interaktiv gefragt" war korrekt
-- fuer den EIGENTLICH GEMEINTEN automatischen Auto-Update-Zyklus (kein
-- Nutzer anwesend) — aber die Bedingung dafuer fehlte komplett, wodurch
-- JEDER manuelle "Rolle behalten"-Lauf ebenfalls faelschlich uebersprungen
-- wurde. Jetzt: nur bei echtem, unbeaufsichtigtem Auto-Update
-- (_G.__xreactor_remote_update == true) wird die gespeicherte Auswahl
-- stillschweigend uebernommen; bei jedem manuellen Lauf wird interaktiv
-- gefragt (Standard-Antwort = zuvor gespeicherte Auswahl beibehalten, bei
-- leerer Eingabe).
if not _G.__xreactor_remote_update and term and term.setCursorPos then
  local function collect_optional_feature_names_reinstall(manifest_tbl, role_label)
    local seen, names = {}, {}
    local function matches_role(entry)
      -- Fix (2026-07-06): dieselbe fehlende Rollen-Filterung wie bei der
      -- ersten collect_optional_feature_names() weiter oben — ein Feature
      -- mit required_for durfte nur bei passender Rolle erscheinen.
      if type(entry.required_for) ~= "table" then return true end
      if not role_label then return true end
      for _, v in ipairs(entry.required_for) do
        if tostring(v):upper() == tostring(role_label):upper() then return true end
      end
      return false
    end
    local function scan(entries)
      for _, e in ipairs(entries or {}) do
        if type(e) == "table" and e.optional == true and e.feature and not seen[e.feature] and matches_role(e) then
          seen[e.feature] = true
          names[#names + 1] = e.feature
        end
      end
    end
    scan(manifest_tbl.base_files)
    for _, rentries in pairs(manifest_tbl.roles or {}) do
      scan(rentries)
    end
    table.sort(names)
    return names
  end
  local feature_names = collect_optional_feature_names_reinstall(manifest, role.label)
  if #feature_names > 0 then
    p("")
    p("Optionale Peripherie-Erweiterungen (nur installieren wenn Hardware vorhanden ist):")
    for _, fname in ipairs(feature_names) do
      local already = selected_features[fname] == true
      io.write("  " .. fname .. " installieren? [j/N" .. (already and ", bereits aktiv" or "") .. "]: ")
      local answer = read and read() or ""
      if tostring(answer):lower() == "j" or tostring(answer):lower() == "y" then
        selected_features[fname] = true
      elseif tostring(answer) ~= "" then
        selected_features[fname] = false
      end
      -- Leere Eingabe = bestehende Auswahl beibehalten (already).
    end
  end
end

-- ── Alte Installation löschen ────────────────────────────────────────────────
if fs.exists(INSTALL_ROOT) then
  p("Entferne alte Installation...")
  pcall(fs.delete, INSTALL_ROOT)
end
pcall(fs.makeDir, INSTALL_ROOT)

-- ── Eingebettete Module zuerst schreiben ─────────────────────────────────────
local embedded = {
  ["installer/http.lua"]        = http_src,
  ["installer/manifest.lua"]    = manifest_src,
  ["installer/stage.lua"]       = stage_src,
  ["installer/ui.lua"]          = ui_src,
  ["installer/auto_update.lua"] = au_src,
  ["installer/init.lua"]        = init_src,
}
for rel, content in pairs(embedded) do
  local ok5, werr = stage_mod.write(INSTALL_ROOT.."/"..rel, content)
  if not ok5 then error("Schreiben: "..rel.." — "..tostring(werr), 0) end
end
p("Eingebettete Module geschrieben")

-- ── Dateien installieren ─────────────────────────────────────────────────────
local expected = manifest_mod.files_for_role(manifest, role.label, selected_features)
local file_list = {}
for rel, entry in pairs(expected) do
  -- Eingebettete Module überspringen (schon geschrieben)
  if not embedded[rel] then
    table.insert(file_list, { path=rel, entry=entry })
  end
end
table.sort(file_list, function(a,b) return a.path < b.path end)

p("Installiere "..#file_list.." Dateien...")
local ok6, err6 = stage_mod.install(
  file_list, INSTALL_ROOT,
  { download_file = function(rel, s) return download(base..rel) end,
    is_html = http_mod.is_html },
  sha,
  function(done, total, rel) ui_mod.progress(done, total, rel) end
)
if not ok6 then error("Installation: "..tostring(err6), 0) end

-- ── Wiederherstellen ─────────────────────────────────────────────────────────
for rel, content in pairs(preserved) do
  local dst = INSTALL_ROOT.."/"..rel
  local dir = fs.getDir(dst)
  if dir and dir~="" and not fs.exists(dir) then pcall(fs.makeDir, dir) end
  local f = fs.open(dst, "w"); if f then f.write(content); f.close() end
  p("Wiederhergestellt: "..rel)
end

-- ── Rolle + Config ───────────────────────────────────────────────────────────
stage_mod.write(INSTALL_ROOT.."/config/role.lua",
  string.format("return { role = %q }\n", role.label))

local auto_cfg = INSTALL_ROOT.."/config/remote_update.lua"
if not fs.exists(auto_cfg) then
  stage_mod.write(auto_cfg,
    "return {\n  enabled = true,\n  auto_update = true,\n  check_interval_s = 120,\n}\n")
end

local startup_path = "/startup.lua"
local startup_content = "-- XReactor startup\nshell.run(\"/xreactor/start.lua\")\n"
local existing = nil
if fs.exists(startup_path) then
  local f = fs.open(startup_path, "r"); if f then existing=f.readAll(); f.close() end
end
if not existing or existing:find("/xreactor/start.lua", 1, true) then
  stage_mod.write(startup_path, startup_content)
  p("startup.lua konfiguriert")
end

ui_mod.ok("Installation abgeschlossen: "..role.label)
_G.__xreactor_installer_completed = true
_G.__xreactor_installer_role = role.label

-- Neustart
p("Neustart in 2 Sekunden...")
os.sleep(2)
os.reboot()
