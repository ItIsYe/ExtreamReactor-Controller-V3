-- optionale Module in Zukunft automatisch hier auftauchen, ohne dass diese
-- Abfrage-Logik jedes Mal angepasst werden muss.
local function collect_optional_feature_names(manifest_tbl)
  local seen, names = {}, {}
  for _, e in ipairs(manifest_tbl.base_files or {}) do
    if type(e) == "table" and e.optional == true and e.feature and not seen[e.feature] then
      seen[e.feature] = true
      names[#names + 1] = e.feature
    end
  end
  table.sort(names)
  return names
end

