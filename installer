if not _G.CONFIG then
  _G.CONFIG = {}
end
local CONFIG = _G.CONFIG

local STORAGE_ROOT = "/xreactor"

local function apply_storage_paths()
  CONFIG.STORAGE_ROOT = STORAGE_ROOT
  CONFIG.BASE_DIR = "/xreactor"
  CONFIG.BACKUP_BASE = "/xreactor_backup"
  CONFIG.UPDATE_STAGING_BASE = "/xreactor_stage"
  CONFIG.LOCAL_STAGING_BASE = "/xreactor_stage"
  CONFIG.LOCAL_BACKUP_BASE = "/xreactor_backup"
  CONFIG.LOCAL_LOG_DIR = "/xreactor_logs"
  CONFIG.LOG_DIR = "/xreactor_logs"
  CONFIG.LOG_ROOT = "/xreactor_logs"
  CONFIG.LOG_PATH = "/xreactor_logs/installer_core.log"
  CONFIG.MANIFEST_LOCAL = "/xreactor/.manifest"
  CONFIG.MANIFEST_CACHE = "/xreactor/.cache/manifest.lua"
  CONFIG.MANIFEST_CACHE_LEGACY = "/xreactor/.manifest_cache"
  CONFIG.NODE_ID_PATH = "/xreactor/config/node_id.txt"
  CONFIG.ROLE_PATH = "/xreactor/config/role.lua"
  CONFIG.UPDATE_MARKER_PATH = "/xreactor/.update_in_progress"
end

local function ensure_directory(path)
  if fs.exists(path) then
    return fs.isDir(path)
  end
  return pcall(fs.makeDir, path)
end

local function download_installer_core(storage_root)
  local core_target_path = storage_root .. "/installer_core.lua"
  if fs.exists(core_target_path) then
    return true
  end

  if not ensure_directory(storage_root) then
    return false, "Unable to create storage root: " .. tostring(storage_root)
  end

  if not http or type(http.get) ~= "function" then
    return false, "HTTP API unavailable"
  end

  local core_url = "https://raw.githubusercontent.com/ItIsYe/ExtreamReactor-Controller-V3/beta/xreactor/installer_core.lua"
  local ok_get, response = pcall(http.get, core_url)
  if not ok_get or not response then
    return false, "Failed to download installer core"
  end

  local ok_read, body = pcall(response.readAll)
  pcall(response.close)
  if not ok_read or type(body) ~= "string" or body == "" then
    return false, "Downloaded installer core is empty"
  end

  local ok_write, write_err = pcall(function()
    local file = fs.open(core_target_path, "w")
    if not file then
      error("open failed", 0)
    end
    file.write(body)
    file.close()
  end)
  if not ok_write then
    return false, "Failed to write installer core: " .. tostring(write_err)
  end

  if not fs.exists(core_target_path) then
    return false, "Installer core missing after download"
  end

  return true
end

local function main()
  apply_storage_paths()

  local core_path = STORAGE_ROOT .. "/installer_core.lua"
  local ok_download, download_err = download_installer_core(STORAGE_ROOT)
  if not ok_download then
    error("Installer core download failed: " .. tostring(download_err))
  end

  if fs.exists(core_path) then
    return shell.run(core_path)
  end

  error("Installer core missing: /xreactor/installer_core.lua")
end

return main()
