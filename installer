-- /installer
-- Bootstrap: lädt xreactor/installer/init.lua und führt ihn aus.

local INSTALL_ROOT = "/xreactor"
local GITHUB_API   = "https://api.github.com/repos/ItIsYe/ExtreamReactor-Controller-V3/branches/beta"
local GITHUB_RAW   = "https://raw.githubusercontent.com/ItIsYe/ExtreamReactor-Controller-V3/"

local function p(msg) pcall(print, tostring(msg)) end

-- HTTP verfügbar?
if not http then
  error("HTTP API nicht verfuegbar! Aktiviere HTTP in der CC-Config.", 0)
end

local function download(url)
  -- Versuch 1: http.get
  local ok, r = pcall(http.get, url)
  if ok and r then
    local ok2, body = pcall(r.readAll); pcall(r.close)
    if ok2 and type(body) == "string" and #body > 0 then
      local s = body:sub(1, 200):lower()
      if s:find("<html", 1, true) or s:find("<!doctype", 1, true) then
        return nil, "HTML-Antwort (CDN-Fehler)"
      end
      return body
    end
    return nil, "readAll fehlgeschlagen"
  end
  -- Fehlermeldung ausgeben
  local err_msg = type(r) == "string" and r or "http.get fehlgeschlagen"
  return nil, err_msg
end

local function download_retry(url, label)
  local delays = {0, 3, 5}
  for attempt = 1, 3 do
    if attempt > 1 then
      p("  Versuch " .. attempt .. "/3 fuer " .. label)
      os.sleep(delays[attempt])
    end
    local body, err = download(url)
    if body then return body end
    p("  WARN: " .. tostring(err))
  end
  return nil, "alle Versuche fehlgeschlagen"
end

local function write(path, content)
  local dir = fs.getDir(path)
  if dir and dir ~= "" and not fs.exists(dir) then pcall(fs.makeDir, dir) end
  local f = fs.open(path, "w")
  if not f then return false, "open fehlgeschlagen: " .. path end
  f.write(content); f.close()
  -- Verifikation
  if not fs.exists(path) then return false, "Datei nach Schreiben nicht vorhanden" end
  return true
end

-- SHA auflösen
local sha = nil
p("Verbinde mit GitHub API...")
local ok_sha, r_sha = pcall(http.get, GITHUB_API)
if ok_sha and r_sha then
  local ok2, body = pcall(r_sha.readAll); pcall(r_sha.close)
  if ok2 and type(body) == "string" then
    sha = body:match('"sha"%s*:%s*"(%x+)"')
  end
else
  p("WARN: GitHub API nicht erreichbar: " .. tostring(r_sha))
end

if sha then
  p("SHA: " .. sha:sub(1, 12))
else
  p("WARN: SHA nicht auflösbar — nutze Branch-URL")
end

local MODULES = {
  "installer/http.lua", "installer/manifest.lua", "installer/stage.lua",
  "installer/ui.lua", "installer/auto_update.lua", "installer/init.lua",
}

p("Lade Installer-Module (" .. #MODULES .. ")...")
for _, rel in ipairs(MODULES) do
  local body, err

  -- SHA-URL zuerst
  if sha then
    body, err = download_retry(GITHUB_RAW .. sha .. "/xreactor/" .. rel, rel)
  end

  -- Branch-URL als Fallback (immer)
  if not body then
    body, err = download_retry(GITHUB_RAW .. "beta/xreactor/" .. rel, rel)
  end

  if not body then
    error("FEHLER: " .. rel .. " konnte nicht geladen werden.\n"
      .. "Bitte prüfe:\n"
      .. "  1. HTTP in CC-Config aktiviert?\n"
      .. "  2. raw.githubusercontent.com in Whitelist?\n"
      .. "  3. Internetverbindung vorhanden?\n"
      .. "Fehler: " .. tostring(err), 0)
  end

  local ok_w, werr = write(INSTALL_ROOT .. "/" .. rel, body)
  if not ok_w then error("Schreiben: " .. tostring(werr), 0) end
  p("  OK " .. rel .. " (" .. #body .. " bytes)")
end

p("Starte Installer...")
dofile(INSTALL_ROOT .. "/installer/init.lua")
if _G.__xreactor_installer_completed then
  p("Fertig -- Neustart..."); os.sleep(1); os.reboot()
end
