-- /installer -- duenner Bootstrap.
--
-- Fix (2026-07-17): CRITICAL. INSTALL-P1 aus docs/CODING_AI_OTHER_NODES_
-- PERFORMANCE_2026-07-12.md (Abschnitt 8, "Zwei unabhaengige Installer-
-- implementierungen"). Diese Datei enthielt bisher vollstaendige
-- eingebettete Textkopien JEDES Installermoduls UND eine komplett
-- eigenstaendige, unabhaengig gepflegte Kopie des gesamten Installations-
-- ablaufs (Manifest laden, Rolle bestimmen, Config sichern, alten Baum
-- loeschen, Dateien installieren, Journal fuehren, Plan validieren, ...) --
-- strukturell identisch zu, aber getrennt von installer/init.lua. Jeder
-- Fix musste doppelt gepflegt und manuell resynchronisiert werden (siehe
-- Git-Historie dieser Datei -- mehrfach in dieser Session).
--
-- Jetzt macht /installer NUR NOCH:
--   1. einen einzigen Source-Ref fuer den gesamten Lauf auswaehlen,
--   2. die kanonischen Installermodule GENAU dieses Refs frisch
--      herunterladen (nicht eingebettet, nicht potenziell veraltet),
--   3. sie per load() in Module umwandeln,
--   4. installer/init.lua (als Funktion mit injizierten Abhaengigkeiten,
--      siehe dortiger Fix-Kommentar) damit aufrufen.
-- installer/init.lua ist ab jetzt die EINZIGE Stelle mit tatsaechlicher
-- Installationslogik -- ob ihre Abhaengigkeiten von der lokalen Platte
-- (dofile(), praktisch ungenutzt) oder aus frisch heruntergeladenem Text
-- (load(), dieser Bootstrap hier) stammen, ist fuer sie irrelevant.

local GITHUB_RAW = "https://raw.githubusercontent.com/ItIsYe/ExtreamReactor-Controller-V3/"

local function p(msg) pcall(print, tostring(msg)) end

if not http then error("HTTP nicht verfuegbar! Bitte HTTP in CC-Config aktivieren.", 0) end

local function looks_like_html(body)
  local s = body:sub(1, 200):lower()
  return s:find("<html", 1, true) ~= nil or s:find("<!doctype", 1, true) ~= nil
end

-- Fix (2026-07-06): diese primitive Bootstrap-Download-Funktion (genutzt,
-- bevor irgendein Installermodul geladen ist -- also auch vor http_mod.
-- download()s eingebautem Retry) hatte urspruenglich KEINEN Retry-
-- Mechanismus -- ein einzelner transienter http.get()-Fehlschlag liess
-- die komplette Erstinstallation sofort abbrechen. Jetzt mit 4 Versuchen
-- und steigender Wartezeit.
--
-- Jeder einzelne Versuch nutzte bisher reines http.get(url) OHNE eigenes
-- Timeout -- verlaesst sich komplett auf den serverseitig konfigurierten
-- http.timeout. Genau das Muster, das installer/http.lua's try_once()
-- (siehe dortige Historie) im Feld haengen liess, bevor es auf
-- parallel.waitForAny() umgebaut wurde: die bewaehrte http.get() gegen
-- ein simples os.sleep()-Timeout race lassen, kein eigenes Event-Matching.
-- Da dieser Bootstrap bei JEDEM Auto-Update erneut heruntergeladen und
-- ausgefuehrt wird (siehe installer/auto_update.lua's run_update()),
-- haengt sonst der gesamte Update-Vorgang an genau dieser Stelle -- noch
-- bevor das bereits gefixte installer/http.lua ueberhaupt geladen ist.
local REQUEST_TIMEOUT_S = 15

local function try_once(url)
  if type(parallel) ~= "table" or type(parallel.waitForAny) ~= "function" then
    local ok, r = pcall(http.get, url)
    if not ok or not r then return nil, type(r) == "string" and r or "http.get fehlgeschlagen" end
    local ok2, body = pcall(r.readAll); pcall(r.close)
    if not ok2 or type(body) ~= "string" or #body == 0 then return nil, "readAll fehlgeschlagen" end
    return body
  end

  local body, err, done = nil, nil, false
  local ok_race, race_err = pcall(parallel.waitForAny,
    function()
      local ok, r = pcall(http.get, url)
      if ok and r then
        local ok2, b = pcall(r.readAll); pcall(r.close)
        if ok2 and type(b) == "string" and #b > 0 then
          body = b
        else
          err = "readAll fehlgeschlagen"
        end
      else
        err = type(r) == "string" and r or "http.get fehlgeschlagen"
      end
      done = true
    end,
    function() os.sleep(REQUEST_TIMEOUT_S) end)

  if not ok_race then return nil, "Anfrage fehlgeschlagen: " .. tostring(race_err) end
  if not done then return nil, "timeout" end
  return body, err
end

local function download(url)
  local last_err
  for attempt = 1, 4 do
    local body, err = try_once(url)
    if body then
      if looks_like_html(body) then
        last_err = "HTML-Antwort (CDN)"
      else
        return body
      end
    else
      last_err = err
    end
    if attempt < 4 then
      p("  Download-Versuch " .. attempt .. " fehlgeschlagen (" .. tostring(last_err) .. "), erneut in " .. (attempt * 2) .. "s ...")
      os.sleep(attempt * 2)
    end
  end
  return nil, last_err
end

-- Use one source ref for the whole run without GitHub's rate-limited branch
-- API. A recovery caller may pin a known commit; ordinary installations use
-- the beta branch and still verify every downloaded file against its manifest
-- hash before committing the installation.
local forced_ref = rawget(_G, "__xreactor_forced_ref")
local ref = forced_ref ~= nil and tostring(forced_ref) or "beta"
p("Ref: " .. ref)
local base = GITHUB_RAW..ref.."/xreactor/"

-- ── Kanonische Installermodule herunterladen ─────────────────────────────────
-- Dieselben Dateien, die auch ein bereits installierter Node unter
-- /xreactor/installer/*.lua liegen hat -- hier frisch vom aufgeloesten Ref,
-- da /xreactor bei der Erstinstallation noch nicht existiert.
local MODULE_NAMES = {
  "http", "manifest", "stage", "ui", "journal", "plan_validator",
  "reactor_naming",
}
local module_src = {}
for _, name in ipairs(MODULE_NAMES) do
  local url = base.."installer/"..name..".lua"
  local body, err = download(url)
  if not body then
    error("Installermodul '"..name.."' konnte nicht heruntergeladen werden: "..tostring(err), 0)
  end
  module_src[name] = body
end

local init_src, init_dl_err = download(base.."installer/init.lua")
if not init_src then
  error("installer/init.lua konnte nicht heruntergeladen werden: "..tostring(init_dl_err), 0)
end

local function load_module(name, src)
  local fn, err = load(src, "="..name, "t", _ENV)
  if not fn then error("Modul "..name.." Syntaxfehler: "..tostring(err), 0) end
  local ok, mod = pcall(fn)
  if not ok then error("Modul "..name.." Ladefehler: "..tostring(mod), 0) end
  return mod
end

local http_mod           = load_module("http",           module_src.http)
local manifest_mod       = load_module("manifest",       module_src.manifest)
local stage_mod          = load_module("stage",           module_src.stage)
local ui_mod             = load_module("ui",               module_src.ui)
local journal_mod        = load_module("journal",         module_src.journal)
local plan_validator_mod = load_module("plan_validator",  module_src.plan_validator)
local reactor_naming_mod = load_module("reactor_naming",  module_src.reactor_naming)

local init_fn, init_syntax_err = load(init_src, "=init", "t", _ENV)
if not init_fn then
  error("installer/init.lua Syntaxfehler: "..tostring(init_syntax_err), 0)
end
local ok_init, init_body = pcall(init_fn)
if not ok_init then
  error("installer/init.lua Ladefehler: "..tostring(init_body), 0)
end
if type(init_body) ~= "function" then
  error("installer/init.lua muss eine Funktion zurueckgeben (return function(deps) ... end)", 0)
end

-- Fuehrt die tatsaechliche Installation aus -- alle Rollenauswahl-,
-- Backup-, Lösch-, Download-, Journal- und Validierungslogik lebt
-- ausschliesslich in installer/init.lua (siehe dortiger Fix-Kommentar).
init_body({
  http_mod = http_mod,
  manifest_mod = manifest_mod,
  stage_mod = stage_mod,
  ui_mod = ui_mod,
  journal_mod = journal_mod,
  plan_validator_mod = plan_validator_mod,
  reactor_naming_mod = reactor_naming_mod,
  ref = ref,
})

-- Neustart
p("Neustart in 2 Sekunden...")
os.sleep(2)
os.reboot()
