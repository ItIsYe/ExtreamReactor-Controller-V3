local INSTALL_ROOT = "/xreactor"
local STAGE_ROOT = "/xreactor_stage"
local BACKUP_ROOT = "/xreactor_backup_prev"
local LOG_DIR = "/xreactor_logs"
local LOG_PATH = LOG_DIR .. "/installer.log"
local STARTUP_PATH = "/startup"
local STARTUP_CONTENT = "-- XReactor startup\nshell.run(\"/xreactor/start.lua\")\n"
local BASE_URL = "https://raw.githubusercontent.com/ItIsYe/ExtreamReactor-Controller-V3/beta/xreactor/"
local MANIFEST_URL = BASE_URL .. "manifest.lua"
local INCLUDE_DEV_FILES = false
local STORAGE_BUFFER_BYTES = 65536
local STORAGE_PERCENT_BUFFER = 0.15

local function safe_mkdir(path)
  if fs.exists(path) then
    return fs.isDir(path)
  end
  local ok = pcall(fs.makeDir, path)
  return ok and fs.exists(path) and fs.isDir(path)
end

local function timestamp()
  if os and os.date then
    return os.date("!%H:%M:%S")
  end
  if os and os.time then
    return tostring(os.time())
  end
  return "unknown-time"
end

local function log_line(message)
  local ok = pcall(function()
    safe_mkdir(LOG_DIR)
    local file = fs.open(LOG_PATH, "a")
    if not file then
      return
    end
    file.write(string.format("[%s] %s\n", timestamp(), tostring(message)))
    file.close()
  end)
  if not ok then
    return
  end
end

local function info(message)
  print(message)
  log_line(message)
end

local function warn(message)
  print(message)
  log_line("WARN: " .. tostring(message))
end

local function error_msg(message)
  print(message)
  log_line("ERROR: " .. tostring(message))
end

local function fatal(message)
  warn(message)
  error(message, 0)
end

local function build_crc32_table()
  local table_crc = {}
  for i = 0, 255 do
    local crc = i
    for _ = 1, 8 do
      if bit32.band(crc, 1) == 1 then
        crc = bit32.bxor(bit32.rshift(crc, 1), 0xEDB88320)
      else
        crc = bit32.rshift(crc, 1)
      end
    end
    table_crc[i] = crc
  end
  return table_crc
end

local CRC32_TABLE = build_crc32_table()

local function crc32_hash(content)
  local crc = 0xFFFFFFFF
  for i = 1, #content do
    local byte = string.byte(content, i)
    local idx = bit32.band(bit32.bxor(crc, byte), 0xFF)
    crc = bit32.bxor(bit32.rshift(crc, 8), CRC32_TABLE[idx])
  end
  return string.format("%08x", bit32.bxor(crc, 0xFFFFFFFF))
end

local function read_file(path)
  local file = fs.open(path, "r")
  if not file then
    return nil
  end
  local content = file.readAll()
  file.close()
  return content
end

local function write_file(path, data)
  local dir = fs.getDir(path)
  if dir and dir ~= "" and not fs.exists(dir) then
    fs.makeDir(dir)
  end

  local h = fs.open(path, "w")
  if not h then
    return false, "open failed"
  end

  h.write(data)
  h.close()
  return true
end

local function is_xreactor_startup(content)
  if not content then
    return false
  end
  if content:find("/xreactor/start.lua", 1, true) then
    return true
  end
  if content:find("XReactor", 1, true) then
    return true
  end
  return false
end

local function ensure_startup_script()
  local existing = nil
  if fs.exists(STARTUP_PATH) then
    existing = read_file(STARTUP_PATH)
  end

  if existing and not is_xreactor_startup(existing) then
    warn("Startup file exists and does not belong to XReactor; leaving unchanged")
    return
  end

  local ok, err = write_file(STARTUP_PATH, STARTUP_CONTENT)
  if not ok then
    warn("Failed to write startup file: " .. tostring(err))
    return
  end
  info("Startup file configured")
end

local function download_url(url)
  if not http or type(http.get) ~= "function" then
    return nil, "HTTP API unavailable"
  end
  local ok, response = pcall(http.get, url)
  if not ok or not response then
    return nil, "Failed to download " .. url
  end
  if response.getResponseCode then
    local code = response.getResponseCode()
    if code ~= 200 then
      pcall(response.close)
      return nil, "HTTP " .. tostring(code) .. " for " .. url
    end
  end
  local ok_read, body = pcall(response.readAll)
  pcall(response.close)
  if not ok_read or type(body) ~= "string" then
    return nil, "Failed to read response from " .. url
  end
  return body
end

local function is_html_content(content)
  if type(content) ~= "string" then
    return false
  end
  local snippet = content:sub(1, 200):lower()
  return snippet:find("<html", 1, true) or snippet:find("<!doctype", 1, true)
end

local function compile_lua(path, content)
  if type(loadfile) == "function" then
    return loadfile(path)
  end
  return load(content or "", "=" .. tostring(path), "t", {})
end

local function validate_download(path)
  if not fs.exists(path) then
    error_msg("Download validation failed: missing file " .. tostring(path))
    return false, "missing file"
  end
  if fs.getSize(path) <= 0 then
    fs.delete(path)
    error_msg("Download validation failed: empty file " .. tostring(path))
    return false, "empty file"
  end
  local content = read_file(path)
  if not content then
    fs.delete(path)
    error_msg("Download validation failed: unreadable file " .. tostring(path))
    return false, "unreadable file"
  end
  if is_html_content(content) then
    fs.delete(path)
    error_msg("Download validation failed: HTML content for " .. tostring(path))
    return false, "html content"
  end
  if path:sub(-4) == ".lua" then
    local loader, err = compile_lua(path, content)
    if not loader then
      fs.delete(path)
      error_msg("Download validation failed: Lua parse error for " .. tostring(path) .. " (" .. tostring(err) .. ")")
      return false, "lua parse error"
    end
  end
  return true
end

local function hash_matches(entry, content)
  if not entry.hash then
    return true
  end
  local computed = crc32_hash(content)
  return string.lower(computed) == string.lower(entry.hash)
end

local function download_file(remote_path, target_path, entry)
  local url = BASE_URL .. remote_path
  info("Downloading " .. remote_path)
  local body, err = download_url(url)
  if not body then
    return false, err
  end
  if not hash_matches(entry or {}, body) then
    return false, "hash mismatch for " .. tostring(remote_path)
  end
  local ok, write_err = write_file(target_path, body)
  if not ok then
    return false, write_err
  end
  local valid, valid_err = validate_download(target_path)
  if not valid then
    return false, valid_err
  end
  return true
end

local function load_manifest()
  info("Downloading manifest")
  local body, err = download_url(MANIFEST_URL)
  if not body then
    return nil, err
  end
  local loader, load_err = load(body, "=manifest", "t", {})
  if not loader then
    return nil, load_err
  end
  local ok, manifest = pcall(loader)
  if not ok then
    return nil, manifest
  end
  if type(manifest) ~= "table" then
    return nil, "Manifest invalid"
  end
  if type(manifest.base_files) ~= "table" or type(manifest.roles) ~= "table" then
    return nil, "Manifest missing base_files or roles"
  end
  return manifest
end

local function select_role()
  print("")
  print("1 MASTER")
  print("2 RT")
  print("3 ENERGY")
  print("4 WATER")
  print("5 FUEL")
  print("6 REPROCESSING")
  write("Select role: ")
  local choice = read()
  local map = {
    ["1"] = { key = "master", label = "MASTER" },
    ["2"] = { key = "rt", label = "RT" },
    ["3"] = { key = "energy", label = "ENERGY" },
    ["4"] = { key = "water", label = "WATER" },
    ["5"] = { key = "fuel", label = "FUEL" },
    ["6"] = { key = "reprocessing", label = "REPROCESSING" }
  }
  return map[choice]
end

local function normalize_file_list(entries)
  local list = {}
  for _, entry in ipairs(entries or {}) do
    if type(entry) == "string" then
      table.insert(list, { path = entry })
    elseif type(entry) == "table" and entry.path then
      local normalized = {
        path = entry.path,
        size_bytes = entry.size_bytes,
        hash = entry.hash,
        always = entry.always,
        required_for = entry.required_for
      }
      table.insert(list, normalized)
    end
  end
  return list
end

local function should_exclude_prod_path(path)
  if type(path) ~= "string" then
    return true
  end
  if path:match("^tests/") then
    return true
  end
  if path:match("^docs/") then
    return true
  end
  if path == "README.md" or path == "MIGRATION.md" then
    return true
  end
  return false
end

local function merge_unique(entries, source)
  for _, entry in ipairs(source or {}) do
    if entry.path and (INCLUDE_DEV_FILES or not should_exclude_prod_path(entry.path)) then
      entries[entry.path] = entry
    end
  end
end

local function flatten_manifest(manifest)
  local merged = {}
  local base_files = normalize_file_list(manifest.base_files)
  for _, entry in ipairs(base_files) do
    if entry.always == nil then
      entry.always = true
    end
  end
  merge_unique(merged, base_files)

  for role_key, role_entries in pairs(manifest.roles or {}) do
    for _, entry in ipairs(normalize_file_list(role_entries)) do
      if type(entry.required_for) ~= "table" then
        entry.required_for = { string.upper(role_key) }
      end
      merge_unique(merged, { entry })
    end
  end

  if INCLUDE_DEV_FILES then
    merge_unique(merged, normalize_file_list(manifest.dev_files))
  end

  local list = {}
  for _, entry in pairs(merged) do
    table.insert(list, entry)
  end
  table.sort(list, function(a, b)
    return tostring(a.path) < tostring(b.path)
  end)
  return list
end

local function role_matches(required_for, role_label)
  if type(required_for) ~= "table" then
    return false
  end
  for _, entry in ipairs(required_for) do
    if tostring(entry):upper() == tostring(role_label):upper() then
      return true
    end
  end
  return false
end

local function select_expected_files(manifest, role_label)
  local expected = {}
  for _, entry in ipairs(flatten_manifest(manifest)) do
    if entry.always == true or role_matches(entry.required_for, role_label) then
      expected[entry.path] = entry
    end
  end
  return expected
end

local function estimate_required_storage(expected)
  local total = 0
  for _, entry in pairs(expected) do
    total = total + math.max(0, tonumber(entry.size_bytes) or 0)
  end
  local percent_buffer = math.floor(total * STORAGE_PERCENT_BUFFER)
  local required = total + STORAGE_BUFFER_BYTES + percent_buffer
  return {
    payload_bytes = total,
    fixed_buffer_bytes = STORAGE_BUFFER_BYTES,
    percent_buffer_bytes = percent_buffer,
    required_bytes = required
  }
end

local function cleanup_stage_and_logs(cleanup_logs)
  if fs.exists(STAGE_ROOT) then
    info("Cleaning stale stage directory")
    fs.delete(STAGE_ROOT)
  end
  if cleanup_logs and fs.exists(LOG_DIR) then
    info("Cleaning log directory to recover storage")
    fs.delete(LOG_DIR)
  end
  local rotated = LOG_DIR .. "/installer.log.1"
  if fs.exists(rotated) then
    fs.delete(rotated)
  end
end

local function preflight_storage(storage_plan, allow_cleanup)
  if not fs.getFreeSpace then
    warn("Free space check unavailable; continuing without preflight")
    return true
  end

  local required_bytes = storage_plan.required_bytes
  local free_bytes = fs.getFreeSpace("/")
  if free_bytes >= required_bytes then
    info(string.format(
      "Storage preflight OK (free=%d payload=%d buffer=%d+%d required=%d)",
      free_bytes,
      storage_plan.payload_bytes,
      storage_plan.fixed_buffer_bytes,
      storage_plan.percent_buffer_bytes,
      required_bytes
    ))
    return true
  end

  warn(string.format(
    "Storage low before install/update (free=%d payload=%d buffer=%d+%d required=%d)",
    free_bytes,
    storage_plan.payload_bytes,
    storage_plan.fixed_buffer_bytes,
    storage_plan.percent_buffer_bytes,
    required_bytes
  ))
  if allow_cleanup then
    cleanup_stage_and_logs(true)
    free_bytes = fs.getFreeSpace("/")
    if free_bytes >= required_bytes then
      info(string.format(
        "Storage preflight OK after cleanup (free=%d payload=%d buffer=%d+%d required=%d)",
        free_bytes,
        storage_plan.payload_bytes,
        storage_plan.fixed_buffer_bytes,
        storage_plan.percent_buffer_bytes,
        required_bytes
      ))
      return true
    end
  end

  return false, string.format(
    "Not enough free space (free=%d payload=%d buffer=%d+%d required=%d)",
    free_bytes,
    storage_plan.payload_bytes,
    storage_plan.fixed_buffer_bytes,
    storage_plan.percent_buffer_bytes,
    required_bytes
  )
end

local function list_files(dir, prefix, out)
  out = out or {}
  prefix = prefix or ""
  for _, name in ipairs(fs.list(dir)) do
    local path = fs.combine(dir, name)
    local rel = prefix .. name
    if fs.isDir(path) then
      list_files(path, rel .. "/", out)
    else
      table.insert(out, rel)
    end
  end
  return out
end

local function ensure_role_config(root_path, role_label)
  local role_path = root_path .. "/config/role.lua"
  local content = string.format("return { role = %q }\n", role_label)
  local ok, err = write_file(role_path, content)
  if not ok then
    warn("Failed to write role config: " .. tostring(err))
  end
end

local function read_role_config()
  local role_path = INSTALL_ROOT .. "/config/role.lua"
  if not fs.exists(role_path) then
    return nil
  end
  local content = read_file(role_path)
  if not content then
    return nil
  end
  local loader = load(content, "=role", "t", {})
  if not loader then
    return nil
  end
  local ok, result = pcall(loader)
  if not ok then
    return nil
  end
  if type(result) == "table" and type(result.role) == "string" then
    return result.role
  end
  return nil
end

local function stage_expected_files(expected)
  if fs.exists(STAGE_ROOT) then
    fs.delete(STAGE_ROOT)
  end
  if not safe_mkdir(STAGE_ROOT) then
    fatal("Unable to create stage root: " .. STAGE_ROOT)
  end
  for _, entry in pairs(expected) do
    local target_path = STAGE_ROOT .. "/" .. entry.path
    local ok, err = download_file(entry.path, target_path, entry)
    if not ok then
      if fs.exists(STAGE_ROOT) then
        fs.delete(STAGE_ROOT)
      end
      return false, "Download failed: " .. tostring(err)
    end
  end
  return true
end

local function copy_config_to_stage()
  local src = INSTALL_ROOT .. "/config"
  local dst = STAGE_ROOT .. "/config"
  if fs.exists(src) and fs.isDir(src) then
    if fs.exists(dst) then
      fs.delete(dst)
    end
    fs.copy(src, dst)
  end
end

local function verify_stage(expected)
  for rel, entry in pairs(expected) do
    local path = STAGE_ROOT .. "/" .. rel
    if not fs.exists(path) then
      return false, "staged file missing: " .. rel
    end
    local content = read_file(path)
    if not content then
      return false, "staged file unreadable: " .. rel
    end
    if entry.hash and not hash_matches(entry, content) then
      return false, "staged hash mismatch: " .. rel
    end
  end
  return true
end

local function activate_stage()
  if fs.exists(BACKUP_ROOT) then
    fs.delete(BACKUP_ROOT)
  end

  if fs.exists(INSTALL_ROOT) then
    fs.move(INSTALL_ROOT, BACKUP_ROOT)
  end

  local moved = pcall(fs.move, STAGE_ROOT, INSTALL_ROOT)
  if not moved then
    warn("Stage activation failed; attempting rollback")
    if fs.exists(INSTALL_ROOT) then
      fs.delete(INSTALL_ROOT)
    end
    if fs.exists(BACKUP_ROOT) then
      fs.move(BACKUP_ROOT, INSTALL_ROOT)
    end
    if fs.exists(STAGE_ROOT) then
      fs.delete(STAGE_ROOT)
    end
    fatal("Failed to activate staged install")
  end

  if fs.exists(BACKUP_ROOT) then
    fs.delete(BACKUP_ROOT)
  end
end

local function log_install_identity(manifest, role_label, mode, expected)
  local release = read_file(INSTALL_ROOT .. "/release.lua")
  local release_id = "unknown"
  if release then
    local loader = load(release, "=release", "t", {})
    if loader then
      local ok, data = pcall(loader)
      if ok and type(data) == "table" then
        release_id = tostring(data.release_id or data.commit_sha or "unknown")
      end
    end
  end
  local file_count = 0
  for _ in pairs(expected) do
    file_count = file_count + 1
  end
  info(string.format(
    "Identity: mode=%s role=%s release=%s manifest=%s files=%d",
    tostring(mode),
    tostring(role_label),
    tostring(release_id),
    tostring(manifest.manifest_id or manifest.manifest_version or "unknown"),
    file_count
  ))
end

local function run_install()
  info("Selected action: Neuinstallation")

  local role = select_role()
  if not role then
    fatal("Invalid role selection")
  end
  info("Selected role: " .. role.label)

  local manifest, err = load_manifest()
  if not manifest then
    fatal("Manifest error: " .. tostring(err))
  end

  local expected = select_expected_files(manifest, role.label)
  local storage_plan = estimate_required_storage(expected)
  local preflight_ok, preflight_err = preflight_storage(storage_plan, true)
  if not preflight_ok then
    fatal("Storage preflight failed: " .. tostring(preflight_err))
  end

  local stage_files_ok, stage_files_err = stage_expected_files(expected)
  if not stage_files_ok then
    fatal(tostring(stage_files_err))
  end
  ensure_role_config(STAGE_ROOT, role.label)
  local stage_ok, stage_err = verify_stage(expected)
  if not stage_ok then
    fs.delete(STAGE_ROOT)
    fatal("Staged validation failed: " .. tostring(stage_err))
  end

  activate_stage()
  ensure_startup_script()
  log_install_identity(manifest, role.label, "install", expected)
  info("Installation complete")
end

local function run_update()
  info("Selected action: Update")
  local manifest, err = load_manifest()
  if not manifest then
    fatal("Manifest error: " .. tostring(err))
  end

  local role_label = read_role_config()
  if not role_label then
    fatal("Role config missing; cannot update")
  end

  local role_key_map = {
    MASTER = "master",
    RT = "rt",
    ENERGY = "energy",
    WATER = "water",
    FUEL = "fuel",
    REPROCESSING = "reprocessing"
  }
  if not role_key_map[role_label] then
    fatal("Unknown role in config: " .. tostring(role_label))
  end
  info("Selected role: " .. role_label)

  local expected = select_expected_files(manifest, role_label)
  local storage_plan = estimate_required_storage(expected)
  local preflight_ok, preflight_err = preflight_storage(storage_plan, false)
  if not preflight_ok then
    fatal("Storage preflight failed: " .. tostring(preflight_err))
  end

  local stage_files_ok, stage_files_err = stage_expected_files(expected)
  if not stage_files_ok then
    fatal(tostring(stage_files_err))
  end
  copy_config_to_stage()
  local stage_ok, stage_err = verify_stage(expected)
  if not stage_ok then
    fs.delete(STAGE_ROOT)
    fatal("Staged validation failed: " .. tostring(stage_err))
  end

  activate_stage()
  ensure_role_config(INSTALL_ROOT, role_label)
  ensure_startup_script()
  log_install_identity(manifest, role_label, "update", expected)
  info("Update complete")
end

local function main()
  log_line("installer start")
  print("XReactor Installer")
  print("")
  print("1 - Neuinstallation")
  print("2 - Update")
  print("3 - Abbrechen")
  write("Select option: ")
  local choice = read()
  if choice == "1" then
    run_install()
  elseif choice == "2" then
    run_update()
  else
    info("Installer cancelled")
  end
end

main()
