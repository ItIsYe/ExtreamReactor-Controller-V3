local plan_validator_mod = dofile("/xreactor/installer/plan_validator.lua")

local INSTALL_ROOT    = "/xreactor"
local STARTUP_PATH    = "/startup.lua"
-- Fix (2026-07-10): CRITICAL. installer/stage.lua's atomarer Schreib-
